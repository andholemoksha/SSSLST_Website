# Backend environment variables
# Copy this file to `.env` and fill in the values.

# YouTube Data API v3 key
# Get a free key: https://console.cloud.google.com/
#   1. Create a project (or use an existing one)
#   2. Enable "YouTube Data API v3"
#   3. Create an API key under Credentials
#   4. Paste it below
YOUTUBE_API_KEY=

# Google Drive API v3 key (used by the Photo Gallery "Sync from Drive" admin action)
# The key stays on the backend only and is never exposed to the frontend.
#   1. In the same Google Cloud project, enable "Google Drive API"
#   2. Create an API key under Credentials (an existing key with Drive enabled also works)
#   3. Share each gallery Drive folder as "Anyone with the link -> Viewer"
#   4. Paste the key below
GOOGLE_API_KEY=
